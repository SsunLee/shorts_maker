# Host URL used to return outputUrl values.
PUBLIC_BASE_URL=http://localhost:8000

# Optional background SFX file used when useSfx=true.
# If missing, engine auto-generates a default ambient SFX track.
DEFAULT_SFX_PATH=assets/sfx.mp3

# ffmpeg binary names (override only if needed)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Higgsfield (drives the official CLI installed on this machine)
# Leave unset to auto-detect `hf` / `higgsfield` on PATH.
# HIGGSFIELD_CLI_PATH=C:\Users\<you>\AppData\Roaming\npm\higgsfield.CMD
HIGGSFIELD_CREATE_TIMEOUT_SEC=300
HIGGSFIELD_UPLOAD_TIMEOUT_SEC=300
